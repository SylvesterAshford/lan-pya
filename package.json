{
  "name": "lan-pya",
  "version": "0.9.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern coverage --ignore-pattern supabase/.temp",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:fast",
    "test:unit": "vitest run",
    "test:db": "supabase test db",
    "test:functions": "deno test supabase/functions/tests --allow-env --allow-net",
    "test:e2e": "playwright test",
    "test:fast": "npm run lint && npm run typecheck && npm run test:unit",
    "test:critical": "npm run test:fast && playwright test --project=chromium --grep @critical",
    "test:release": "npm run test:fast && npm run test:functions && npm run test:e2e",
    "demo:provision": "node scripts/provision-demo-account.mjs",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.99.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-intl": "^4.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^28.0.0",
    "supabase": "^2.76.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.0.18"
  },
  "type": "module"
}
